<?xml version="1.0" encoding="utf-8"?>
<!-- Rex servers can listen on the local network over plain HTTP (rex server run, extra-listen http),
     and users may type a tailnet IP or LAN address with http:// or ws://, so cleartext is allowed for
     addresses the user enters. Tailscale traffic is WireGuard-encrypted either way; the server form
     warns when an address would connect unencrypted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
